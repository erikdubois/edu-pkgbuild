# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-servicemenus
_destname="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.06
pkgrel=104
pkgdesc="KDE Plasma Dolphin service-menu actions for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-servicemenus"
license=('GPL3')
makedepends=('git')
conflicts=('edu-plasma-servicemenus-git')
depends=('imagemagick' 'kdialog' 'meld' 'kdesu' 'mintstick' 'gittyup' 'code' 'alacritty')
provides=("${pkgname}")
replaces=('arcolinux-plasma-kservices-git' 'edu-plasma-servicemenus-git')
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-servicemenus.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	cp -r  ${srcdir}/${pkgname}${_destname} ${pkgdir}${_destname}
}
