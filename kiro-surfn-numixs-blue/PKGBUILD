# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-surfn-numixs-blue
pkgver=26.06
pkgrel=100
_destname="/usr/share/icons/"
pkgdesc="Surfn is a colourful icon theme."
arch=('any')
url="https://github.com/kirodubes/kiro-surfn-numixs-blue"
license=('Attribution-NonCommercial-ShareAlike 4.0 International Public License')
conflicts=('edu-surfn-numixs-blue-git')
replaces=('edu-surfn-numixs-blue-git')
makedepends=('git')
options=(!strip !emptydirs)
source=('Surfn::git+https://github.com/kirodubes/kiro-surfn-numixs-blue.git')
sha256sums=('SKIP')

package() {
  find ${srcdir}/Surfn/surfn-icons -type f -name "*.sh" -exec chmod 644 '{}' \;
  install -dm 755 ${pkgdir}${_destname}
  cp -r ${srcdir}/Surfn/surfn-icons/* ${pkgdir}${_destname}
}