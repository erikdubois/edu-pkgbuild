set -euo pipefail

GREEN=$(tput setaf 2 2>/dev/null || true)
YELLOW=$(tput setaf 3 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

_info() { echo "${GREEN}${*}${RESET}"; }
_warn() { echo "${YELLOW}${*}${RESET}"; }

_find_conf() {
    if [ -f /etc/sddm.conf.d/kde_settings.conf ]; then
        echo /etc/sddm.conf.d/kde_settings.conf
    elif [ -f /etc/sddm.conf ]; then
        echo /etc/sddm.conf
    fi
}

_set_key() {
    local file="$1" key="$2" value="$3"
    if grep -q "^${key}=" "$file"; then
        sed -i "/^${key}=/c ${key}=${value}" "$file"
    else
        echo "${key}=${value}" >> "$file"
    fi
}

post_install() {
    local conf
    conf=$(_find_conf)

    if [ -z "$conf" ]; then
        _warn "No SDDM config file found — theme not set"
        return
    fi

    echo
    _info "Configuring SDDM in ${conf}"
    _set_key "$conf" "Current" "edu-simplicity"
    _set_key "$conf" "DisplayServer" "x11"
    _info "Theme set to edu-simplicity; DisplayServer set to x11"
    echo
}

post_upgrade() {
    post_install
}

post_remove() {
    local conf
    conf=$(_find_conf)

    if [ -z "$conf" ]; then
        echo
        _warn "No SDDM config file found — nothing to clear"
        echo
        return
    fi

    echo
    _info "Clearing SDDM theme in ${conf}"
    _set_key "$conf" "Current" ""
    _info "Theme cleared"
    echo
}
