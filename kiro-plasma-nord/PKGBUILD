pkgname=kiro-plasma-nord
pkgver=26.06
pkgrel=14
pkgdesc="Nord Plasma global theme — 2 variants (Nordic, Darker): desktoptheme, look-and-feel, aurorae, color schemes, Kvantum, SDDM; Surfn-Mint-Y-Aqua icons + Nord cursors"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-nord.git"
license=('GPL3' 'CC-BY-SA-4.0')
depends=('surfn-mint-y-icons-git' 'kvantum' 'sddm' 'kiro-kvantum')
makedepends=('git')
provides=("${pkgname}")
options=(!strip !emptydirs)
install=kiro-plasma-nord.install
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')

package() {
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/usr"
    cp -a "${srcdir}/${pkgname}/etc" "${pkgdir}/etc"
}
