# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-zsh-config
_destname1="/etc/skel/"
pkgver=26.06
pkgrel=02
pkgdesc="Zsh shell configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-zsh-config"
license=('GPL3')
makedepends=('git')
depends=('zsh')
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}.git")
sha256sums=('SKIP')
package() {
    install -dm755 "${pkgdir}${_destname1}"
    cp -a "${srcdir}/${pkgname}${_destname1}".* "${pkgdir}${_destname1}"
}
