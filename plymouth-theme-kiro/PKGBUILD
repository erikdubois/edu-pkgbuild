# Maintainer: Erik Dubois <erik.dubois@gmail.com>

pkgname=plymouth-theme-kiro
pkgver=26.05
pkgrel=02
pkgdesc="Star Trek Starfleet boot splash theme for Plymouth"
arch=('any')
url="https://github.com/erikdubois/plymouth-theme-kiro"
license=('MIT')
depends=('plymouth')
install="${pkgname}.install"
source=("git+${url}.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/plymouth-theme-kiro"
    install -d "${pkgdir}/usr/share/plymouth/themes/kiro"
    install -m644 usr/share/plymouth/themes/kiro/*.png \
        "${pkgdir}/usr/share/plymouth/themes/kiro/"
    install -m644 usr/share/plymouth/themes/kiro/kiro.plymouth \
        "${pkgdir}/usr/share/plymouth/themes/kiro/"
    install -m644 usr/share/plymouth/themes/kiro/kiro.script \
        "${pkgdir}/usr/share/plymouth/themes/kiro/"
}
