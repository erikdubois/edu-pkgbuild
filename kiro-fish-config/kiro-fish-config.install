post_install() {
    echo -e "\n** Kiro fish config installed to /etc/skel/.config/fish/ **"
    echo -e "** New users inherit it automatically. **"
    echo -e "** To use it on your current account, copy the stub to your home: **"
    echo -e "**   cp /etc/skel/.config/fish/config.fish ~/.config/fish/config.fish **\n"
}

post_upgrade() {
    post_install
}
