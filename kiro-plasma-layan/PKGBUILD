pkgname=kiro-plasma-layan
pkgver=26.06
pkgrel=03
pkgdesc="Layan Plasma global theme — Layan + Layan Light (desktoptheme, look-and-feel, aurorae, color schemes, Kvantum, SDDM, Layan cursors); Tela icons"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-layan.git"
license=('GPL3')
depends=('tela-icon-theme' 'kvantum' 'sddm')
makedepends=('git')
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')

package() {
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/usr"
    cp -a "${srcdir}/${pkgname}/etc" "${pkgdir}/etc"
}
